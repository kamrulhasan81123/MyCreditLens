# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mycreditlens
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/mycreditlens

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — generate a strong secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Required (non-default) whenever APP_ENV is not development/test, or the app refuses to start.
JWT_SECRET=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Model artifacts — active application-PD bundle (relative to backend/).
MODEL_ARTIFACT_PATH=./ml/artifacts/application_pd
REQUIRE_MODEL_ARTIFACTS=false
ALLOW_DEMO_SCORING=true

# MLflow (optional)
MLFLOW_TRACKING_URI=http://localhost:5000

# Supabase (optional until configured)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=financial-documents
